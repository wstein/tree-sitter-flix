{
  "schemaVersion": 1,
  "consumer": "tree-sitter-flix",
  "description": "Maps tree-sitter-flix's snake_case node vocabulary onto canonical TreeKind names. Partial by design: it covers the node types the fixture suite actually exercises. Anything neither mapped nor ignored is reported as unmapped, which is a gap rather than a decision, so the report distinguishes 'not mapped yet' from 'disagrees with the reference'.",
  "mappings": {
    "ERROR": "ErrorTree",
    "apply_expression": "Expr.Apply",
    "argument_list": "ArgumentList",
    "ascribe_expression": "Expr.Ascribe",
    "associated_type_signature": "Decl.AssociatedTypeSig",
    "binary_expression": "Expr.Binary",
    "binary_type": "Type.Binary",
    "block": "Expr.Block",
    "block_expression": "Expr.Block",
    "case_set_type": "Type.CaseSet",
    "char": "Expr.Literal",
    "debug_interpolation": "Expr.DebugInterpolator",
    "derivations": "Type.DerivationList",
    "effect_annotation": "Type.Effect",
    "effect_declaration": "Decl.Effect",
    "effect_set_type": "Type.EffectSet",
    "enum_case": "Case",
    "enum_declaration": "Decl.Enum",
    "equality_constraints": "Decl.EqualityConstraintList",
    "ext_match_expression": "Expr.ExtMatch",
    "ext_match_lambda": "Expr.LambdaExtMatch",
    "ext_tag_expression": "Expr.ExtTag",
    "extensible_type": "Type.Extensible",
    "fixpoint_constraint_set": "Expr.FixpointConstraintSet",
    "fixpoint_inject": "Expr.FixpointInject",
    "fixpoint_lambda": "Expr.FixpointLambda",
    "fixpoint_query": "Expr.FixpointQuery",
    "fixpoint_solve": "Expr.FixpointSolveWithProject",
    "for_applicative_expression": "Expr.ForApplicative",
    "for_monadic_expression": "Expr.ForMonadic",
    "foreach_expression": "Expr.Foreach",
    "function_declaration": "Decl.Def",
    "generic_operator": "Ident",
    "get_field": "Expr.GetField",
    "handler_expression": "Expr.Handler",
    "hole_anonymous": "Expr.Hole",
    "hole_named": "Expr.Hole",
    "hole_variable": "Expr.HoleVariable",
    "if_expression": "Expr.IfThenElse",
    "import_declaration": "UsesOrImports.Import",
    "index_expression": "Expr.Index",
    "instance_declaration": "Decl.Instance",
    "intrinsic": "Expr.Intrinsic",
    "invoke_method": "Expr.InvokeMethod",
    "java_qualified_name": "QName",
    "kind": "Kind",
    "lambda": "Expr.Lambda",
    "lambda_expression": "Expr.Lambda",
    "law_declaration": "Decl.Law",
    "let_expression": "Expr.LetMatch",
    "list_literal": "Expr.LiteralList",
    "local_def_expression": "Expr.LocalDef",
    "map_literal": "Expr.LiteralMap",
    "match_expression": "Expr.Match",
    "match_lambda": "Expr.LambdaMatch",
    "match_rule": "Expr.MatchRuleFragment",
    "module_declaration": "Decl.Module",
    "name_lower": "Ident",
    "name_upper": "Ident",
    "named_argument": "ArgumentNamed",
    "new_expression": "Expr.AmbiguousNew",
    "null": "Expr.Literal",
    "operation_declaration": "Decl.Op",
    "operator": "Operator",
    "operator_lambda": "Expr.OperatorAsLambda",
    "parameter": "Parameter",
    "parameter_list": "ParameterList",
    "paren_expression": "Expr.Paren",
    "qualified_name": "QName",
    "record_expression": "Expr.RecordOperation",
    "record_row_type": "Type.RecordRow",
    "record_select": "Expr.RecordSelect",
    "record_type": "Type.Record",
    "regex": "Expr.Literal",
    "region_expression": "Expr.Region",
    "restrictable_enum_declaration": "Decl.RestrictableEnum",
    "restriction_parameter": "Parameter",
    "run_expression": "Expr.Run",
    "schema_row_type": "Type.SchemaRow",
    "schema_type": "Type.Schema",
    "select_expression": "Expr.Select",
    "sequence_expression": "Expr.Statement",
    "set_literal": "Expr.LiteralSet",
    "signature_declaration": "Decl.Signature",
    "source_file": "Root",
    "static_expression": "Expr.Static",
    "string": "Expr.Literal",
    "string_interpolation": "Expr.StringInterpolation",
    "struct_declaration": "Decl.Struct",
    "struct_field": "StructField",
    "struct_get": "Expr.StructGet",
    "struct_put": "Expr.StructPut",
    "tag_pattern": "Pattern.Tag",
    "trailing_dot": "TrailingDot",
    "trait_constraints": "Type.ConstraintList",
    "trait_declaration": "Decl.Trait",
    "try_expression": "Expr.Try",
    "tuple_expression": "Expr.Tuple",
    "tuple_pattern": "Pattern.Tuple",
    "tuple_type": "Type.Tuple",
    "type_alias_declaration": "Decl.TypeAlias",
    "type_application": "Type.Apply",
    "type_argument": "Type.Argument",
    "type_argument_list": "Type.ArgumentList",
    "type_ascription": "Type.Ascribe",
    "type_constant": "Type.Constant",
    "type_parameter_list": "TypeParameterList",
    "type_variable": "Type.Variable",
    "unary_expression": "Expr.Unary",
    "unary_type": "Type.Unary",
    "unchecked_cast": "Expr.UncheckedCast",
    "unterminated_literal": "ErrorTree",
    "unterminated_string": "ErrorTree",
    "use_declaration": "UsesOrImports.Use",
    "use_expression": "Expr.Use",
    "variable_pattern": "Pattern.Variable",
    "vector_literal": "Expr.LiteralVector",
    "wildcard": "Ident"
  },
  "ignored": [
    "annotation",
    "argument",
    "block_comment",
    "comment",
    "derivations",
    "doc_comment",
    "effect_annotation",
    "enum_body",
    "line_comment",
    "modifier",
    "qualified_name",
    "type_reference",
    "variable_pattern"
  ],
  "elide": [
    "AnnotationList",
    "Argument",
    "CommentList",
    "Doc",
    "Expr.Expr",
    "Expr.Statement",
    "ModifierList",
    "Pattern.Pattern",
    "Pattern.Variable",
    "Predicate.Body",
    "QName",
    "Type.Apply",
    "Type.Argument",
    "Type.Effect",
    "Type.Type",
    "UsesOrImports.UseOrImportList"
  ],
  "notes": {
    "name_lower": "Both name_lower and name_upper collapse to Ident: the reference does not distinguish case in the tree, only in the lexer.",
    "type_reference": "Transparent, not mapped: the reference wraps most types in Type.Type, which is elided on the expected side, so the consumer's equivalent wrapper must be dropped symmetrically.",
    "QName": "Elided only when single-child: the reference wraps a lone identifier in QName, which tree-sitter emits bare. A multi-part QName (Foo.Bar) has several children and is kept, so genuine qualification is still compared.",
    "argument": "Transparent, not mapped: canonical Argument is a single-child wrapper and is elided on the expected side, so the consumer's equivalent must be dropped symmetrically.",
    "ERROR": "tree-sitter's built-in ERROR node is the counterpart of the reference's ErrorTree. Mapping it lets negative fixtures be compared on where the parsers agree an error occurred, not just on whether both failed."
  },
  "flatten": [
    "effect_body",
    "enum_body",
    "match_body",
    "trait_body"
  ],
  "flattenCanonical": [
    "UsesOrImports.UseOrImportList"
  ]
}
