    "type_alias_declaration": "Decl.TypeAlias",
    "type_application": "Type.Apply",
    "type_argument_list": "Type.ArgumentList",
    "type_ascription": "Type.Ascribe",
    "type_constant": "Type.Constant",
    "type_parameter": "Parameter",
    "type_parameter_list": "TypeParameterList",
    "type_variable": "Type.Variable",
    "unary_expression": "Expr.Unary",
    "unary_pattern": "Pattern.Unary",
    "unary_type": "Type.Unary",
    "unchecked_cast": "Expr.UncheckedCast",
    "unit_expression": "Expr.Tuple",
    "unsafe_expression": "Expr.Unsafe",
    "unterminated_literal": "ErrorTree",
    "unterminated_string": "ErrorTree",
    "use_declaration": "UsesOrImports.Use",
    "use_expression": "Expr.Use",
    "use_many": "UsesOrImports.UseMany",
    "vector_literal": "Expr.LiteralVector",
    "wildcard": "Ident"
  },
  "ignored": [
    "annotation",
    "argument",
    "block_comment",
    "comment",
    "debug_interpolation",
    "derivations",
    "doc_comment",
    "effect_annotation",
    "enum_body",
    "hole_variable",
    "line_comment",
    "modifier",
    "qualified_name",
    "type_argument",
    "type_reference",
    "variable_pattern"
  ],
  "elide": [
    "AnnotationList",
    "CommentList",
    "Expr.Expr",
    "Expr.FixpointWith",
    "Expr.RunWithBodyExpr",
    "Expr.Statement",
    "ModifierList",
    "Pattern.Pattern",
    "QName",
    "Type.Apply",
    "UsesOrImports.UseOrImportList"
  ],
  "notes": {
    "ERROR": "tree-sitter's built-in ERROR node is the counterpart of the reference's ErrorTree. It is declared in recoveryMarkers, not flatten: the structural lane splices it out of our side exactly as flix-spec's normalization splices ErrorTree out of the canonical side, and the recovery lane keeps it on both so where the two parsers decide an error occurred is actually compared.",
    "QName": "Elided only when single-child: the reference wraps a lone identifier in QName, which tree-sitter emits bare. A multi-part QName (Foo.Bar) has several children and is kept, so genuine qualification is still compared.",
    "argument": "Transparent, not mapped: canonical Argument is a single-child wrapper and is elided on the expected side, so the consumer's equivalent must be dropped symmetrically.",
    "debug_interpolation": "Transparent on our side, mirroring ast/transparency.json's rule for the canonical kind it used to map onto. The mapping was unreachable once the reference stopped emitting that node, and an unreachable mapping manufactures divergences rather than doing nothing.",
    "hole_variable": "Transparent on our side, mirroring ast/transparency.json's rule for the canonical kind it used to map onto. The mapping was unreachable once the reference stopped emitting that node, and an unreachable mapping manufactures divergences rather than doing nothing.",
    "name_lower": "Both name_lower and name_upper collapse to Ident: the reference does not distinguish case in the tree, only in the lexer.",
    "trailing_dot": "A recovery marker, mapped to the reference's TrailingDot. Both are spliced out of the structural comparison and compared in the recovery lane.",
    "type_argument": "Transparent on our side, mirroring ast/transparency.json's rule for the canonical kind it used to map onto. The mapping was unreachable once the reference stopped emitting that node, and an unreachable mapping manufactures divergences rather than doing nothing.",
    "type_reference": "Transparent, not mapped: the reference wraps most types in Type.Type, which is elided on the expected side, so the consumer's equivalent wrapper must be dropped symmetrically.",
    "unterminated_literal": "A recovery marker. The reference has no node here at all -- its lexer emits an Err token and the enclosing production keeps it -- so this is a genuine modelling difference, and the recovery lane is where it is measured rather than absorbed.",
    "unterminated_string": "A recovery marker. The reference has no node here at all -- its lexer emits an Err token and the enclosing production keeps it -- so this is a genuine modelling difference, and the recovery lane is where it is measured rather than absorbed."
  },
  "flatten": [
    "effect_body",
    "enum_body",
    "ext_match_body",
    "for_fragments",
    "handler_body",
    "instance_body",
    "match_body",
    "par_fragments",
    "trait_body"
  ],
  "flattenCanonical": [
    "Predicate.Param",
    "UsesOrImports.UseOrImportList"
  ],
  "recoveryMarkers": [
    "ERROR",
    "trailing_dot",
    "unterminated_literal",
    "unterminated_string"
  ]
}
