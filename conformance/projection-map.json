    "catch_rule": "Expr.TryCatchRuleFragment",
    "char": "Expr.Literal",
    "checked_effect_cast": "Expr.CheckedEffectCast",
    "checked_type_cast": "Expr.CheckedTypeCast",
    "cons_pattern": "Pattern.FCons",
    "debug_prefix": "Expr.StringInterpolation",
    "derivations": "Type.DerivationList",
    "effect_declaration": "Decl.Effect",
    "effect_set_type": "Type.EffectSet",
    "enum_case": "Case",
