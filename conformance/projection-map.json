    "ext_match_rule": "Expr.ExtMatchRuleFragment",
    "ext_tag_expression": "Expr.ExtTag",
    "extensible_type": "Type.Extensible",
    "fixpoint_constraint": "Expr.FixpointConstraint",
    "fixpoint_constraint_set": "Expr.FixpointConstraintSet",
    "fixpoint_from": "Expr.FixpointFromFragment",
    "fixpoint_inject": "Expr.FixpointInject",
    "fixpoint_lambda": "Expr.FixpointLambda",
    "fixpoint_psolve": "Expr.FixpointSolveWithProvenance",
    "fixpoint_query": "Expr.FixpointQuery",
    "fixpoint_query_with_provenance": "Expr.FixpointQueryWithProvenance",
    "fixpoint_select": "Expr.FixpointSelect",
    "fixpoint_solve": "Expr.FixpointSolveWithProject",
    "fixpoint_where": "Expr.FixpointWhere",
    "float": "Expr.Literal",
    "for_applicative_expression": "Expr.ForApplicative",
    "for_generator": "Expr.ForFragmentGenerator",
